# ~/.config/labwc/autostart
#
# Current Raspberry Pi OS uses labwc (Wayland). X11-era instructions using
# xset, unclutter, or ~/.config/lxsession/ do nothing here.

# Blank the display overnight rather than running the panel 24/7.
# Known issue: on some panels the display does not wake cleanly from wlopm.
# Test this before mounting anything on a wall.
swayidle -w \
  timeout 1800 'wlopm --off \*' \
  resume 'wlopm --on \*' &

# Launch the kiosk via the relaunch-loop wrapper so it survives crashes and a
# deploy can reload it by killing Chromium (the loop brings it back). All the
# Chromium flags live in deploy/kiosk.sh.
~/home-manager/deploy/kiosk.sh &
