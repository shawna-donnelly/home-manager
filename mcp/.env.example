# Recipe importer MCP server.
# The home-manager API it writes to (on the Pi: http://localhost:8080).
HOME_MANAGER_URL=http://localhost:8080
# A strong shared secret; the MCP client sends it as "Authorization: Bearer ...".
# Generate one: openssl rand -hex 32
MCP_TOKEN=
# Port this server listens on.
MCP_PORT=8790
