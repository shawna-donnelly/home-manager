PORT=8080
POLL_INTERVAL_MS=300000
CACHE_DIR=./.cache
# Chores/todos are stored here (real data, back it up with the Pi).
DATA_DIR=./.data

# Chore chart columns and the To-Do heading. Empty KIDS hides the Chores tab.
KIDS=Killian,Aubrey,Max
PARENTS=Shawna,Justin
# What a perfect chore week can be redeemed for (comma-separated).
# Defaults to Cash,Robux when unset.
#REWARDS=Cash,Robux,Movie night

# Passcode required to delete a chore (kids can still check them off).
# Digits only — the display shows a numeric pad. Empty disables the check.
CHORE_PIN=1234

# Email notifications: chore deletions (immediate) and a daily report of
# unfinished chores at CHORE_REPORT_TIME (no email when everything's done).
# All four SMTP_/NOTIFY_ values required to enable. For Gmail: 2FA must be on,
# then create an app password at myaccount.google.com/apppasswords.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=you@gmail.com
#SMTP_PASS=<16-char app password>
#NOTIFY_EMAIL=you@gmail.com,partner@gmail.com
#CHORE_REPORT_TIME=20:00

# Colors go WITHOUT the leading # everywhere in this file — node's --env-file
# parser treats unquoted # as a comment and truncates the value.

# ICS feeds (non-Google, or public calendars). Format: label|color|url
#CALENDAR_1=School|f2994a|https://example.org/feed.ics

# Google Calendar API — preferred for Google calendars: near-real-time and
# sees calendars shared with you. Setup is in the README; the refresh token
# and calendar ids come from `yarn auth:google`.
# Format: label|color|calendarId ("primary" = your own main calendar)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REFRESH_TOKEN=
#GCAL_1=Shawna|4c8dff|primary
#GCAL_2=Mom|9b59b6|xxxxxxxx@group.calendar.google.com

# Home Assistant sensor hub. Leave unset to run without sensors.
# Token: HA profile > Security > Long-lived access tokens.
# HA_ENTITIES is a comma-separated list in display order; leave unset to show
# every sensor.* and binary_sensor.* entity (noisy — fine for first setup).
#HA_URL=http://localhost:8123
#HA_TOKEN=
#HA_ENTITIES=sensor.kitchen_temperature,sensor.kitchen_humidity,binary_sensor.front_door
