{
  "name": "home-manager-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,env --exec \"tsx --env-file-if-exists=.env src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "auth:google": "tsx --env-file-if-exists=.env src/scripts/google-auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "node-ical": "^0.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
