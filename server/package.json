{
  "name": "home-manager-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon --exitcrash --watch src --watch .env --ext ts,env --exec \"tsx --env-file-if-exists=.env src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "auth:google": "tsx --env-file-if-exists=.env src/scripts/google-auth.ts",
    "typecheck": "tsc --noEmit",
    "import:enex": "tsx src/scripts/import-enex.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.0.0",
    "node-ical": "^0.20.0",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "yarn@4.10.3"
}
